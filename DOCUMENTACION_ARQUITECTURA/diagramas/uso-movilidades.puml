@startuml
title Casos de uso movilidades
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "movilidades" {
usecase "crear\nPOST /api/v1/movilidades" as U0
usecase "listar\nGET /api/v1/movilidades" as U1
usecase "reporteUso\nGET /api/v1/movilidades/reportes/uso" as U2
usecase "dashboard\nGET /api/v1/movilidades/dashboard" as U3
usecase "obtener\nGET /api/v1/movilidades/{id}" as U4
usecase "actualizar\nPUT /api/v1/movilidades/{id}" as U5
usecase "desactivar\nDELETE /api/v1/movilidades/{id}" as U6
usecase "asignarConductor\nPOST /api/v1/movilidades/{id}/asignar-conductor" as U7
usecase "historial\nGET /api/v1/movilidades/{id}/historial" as U8
}
ADMIN -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
ADMIN -- U6
ADMIN -- U7
ADMIN -- U8
MULTIFUNCIONAL -- U8
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

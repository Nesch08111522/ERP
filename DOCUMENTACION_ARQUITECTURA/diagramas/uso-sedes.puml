@startuml
title Casos de uso sedes
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "sedes" {
usecase "findBySede\nGET /api/v1/almacenes/sede/{sedeId}" as U0
usecase "sedes\nGET /api/v1/public/sedes" as U1
usecase "crearSede\nPOST /api/v1/sedes" as U2
usecase "listarTodas\nGET /api/v1/sedes" as U3
usecase "listarPorEstado\nGET /api/v1/sedes/estado" as U4
usecase "mapa\nGET /api/v1/sedes/mapa" as U5
usecase "verImagen\nGET /api/v1/sedes/imagenes" as U6
usecase "buscarPorId\nGET /api/v1/sedes/{id}" as U7
usecase "subirImagen\nPOST /api/v1/sedes/{id}/imagen" as U8
usecase "actualizarSede\nPUT /api/v1/sedes/{id}" as U9
usecase "eliminarSede\nDELETE /api/v1/sedes/{id}" as U10
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
ADMIN -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
ADMIN -- U8
ADMIN -- U9
ADMIN -- U10
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

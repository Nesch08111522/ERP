@startuml
title Casos de uso reembolsos
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "reembolsos" {
usecase "crear\nPOST /api/v1/reembolsos" as U0
usecase "buscar\nGET /api/v1/reembolsos" as U1
usecase "obtener\nGET /api/v1/reembolsos/{id}" as U2
usecase "procesar\nPOST /api/v1/reembolsos/{id}/procesar" as U3
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

@startuml
title Casos de uso users
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "users" {
usecase "porUsuario\nGET /api/v1/auditoria/logs/usuario/{userId}" as U0
usecase "porEmpleado\nGET /api/v1/rrhh/comisiones/empleado/{userId}" as U1
usecase "porRepartidor\nGET /api/v1/despachos/repartidor/{userId}" as U2
usecase "porEmpleado\nGET /api/v1/rrhh/turnos/empleado/{userId}" as U3
usecase "crearUsuario\nPOST /api/v1/users" as U4
usecase "listarUsuarios\nGET /api/v1/users" as U5
usecase "buscarUsuarioPorId\nGET /api/v1/users/{id}" as U6
usecase "actualizarUsuario\nPUT /api/v1/users/{id}" as U7
usecase "eliminarUsuario\nDELETE /api/v1/users/{id}" as U8
}
ADMIN -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
ADMIN -- U5
ADMIN -- U6
ADMIN -- U7
ADMIN -- U8
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

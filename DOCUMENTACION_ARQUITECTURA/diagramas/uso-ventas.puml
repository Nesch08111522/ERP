@startuml
title Casos de uso ventas
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "ventas" {
usecase "porVenta\nGET /api/v1/devoluciones/venta/{ventaId}" as U0
usecase "vendedores\nGET /api/v1/reportes/ventas/vendedores" as U1
usecase "resumenVentas\nGET /api/v1/reportes/ventas/resumen" as U2
usecase "ventas\nGET /api/v1/reportes/ventas" as U3
usecase "exportarVentas\nGET /api/v1/reportes/ventas/exportar" as U4
usecase "registrar\nPOST /api/v1/ventas" as U5
usecase "obtener\nGET /api/v1/ventas/{id}" as U6
usecase "buscar\nGET /api/v1/ventas" as U7
usecase "anular\nPOST /api/v1/ventas/{id}/anulacion" as U8
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
ADMIN -- U8
MULTIFUNCIONAL -- U8
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

@startuml
title Casos de uso mensajes-web
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "mensajes-web" {
usecase "listar\nGET /api/v1/mensajes-web" as U0
usecase "nuevos\nGET /api/v1/mensajes-web/nuevos" as U1
usecase "sinLeer\nGET /api/v1/mensajes-web/sin-leer" as U2
usecase "mensajeLeido\nPOST /api/v1/mensajes-web/{id}/leido" as U3
usecase "mensajeNoLeido\nPOST /api/v1/mensajes-web/{id}/no-leido" as U4
usecase "archivarMensaje\nPOST /api/v1/mensajes-web/{id}/archivo" as U5
usecase "eliminarMensaje\nDELETE /api/v1/mensajes-web/{id}" as U6
usecase "gestionar\nPATCH /api/v1/mensajes-web/{id}/gestionar" as U7
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

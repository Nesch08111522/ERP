@startuml
title Casos de uso catalogo-fracciones
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "catalogo-fracciones" {
usecase "create\nPOST /api/v1/catalogo-fracciones" as U0
usecase "update\nPUT /api/v1/catalogo-fracciones/{id}" as U1
usecase "findById\nGET /api/v1/catalogo-fracciones/{id}" as U2
usecase "search\nGET /api/v1/catalogo-fracciones" as U3
usecase "findAvailableByProducto\nGET /api/v1/catalogo-fracciones/producto/{productoId}/disponibles" as U4
usecase "delete\nDELETE /api/v1/catalogo-fracciones/{id}" as U5
usecase "validateFactor\nGET /api/v1/catalogo-fracciones/validar-factor" as U6
usecase "dashboard\nGET /api/v1/catalogo-fracciones/estadisticas/dashboard" as U7
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

@startuml
title Casos de uso compras
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "compras" {
usecase "getClientesWithPurchases\nGET /api/v1/clientes/compras/activos" as U0
usecase "getClientesWithoutPurchases\nGET /api/v1/clientes/compras/inactivos" as U1
usecase "crear\nPOST /api/v1/compras" as U2
usecase "actualizar\nPUT /api/v1/compras/{id}" as U3
usecase "obtener\nGET /api/v1/compras/{id}" as U4
usecase "buscar\nGET /api/v1/compras" as U5
usecase "recibir\nPOST /api/v1/compras/{id}/recepcion" as U6
usecase "anular\nPOST /api/v1/compras/{id}/anulacion" as U7
usecase "eliminar\nDELETE /api/v1/compras/{id}" as U8
usecase "dashboard\nGET /api/v1/compras/dashboard" as U9
usecase "subirAdjunto\nPOST /api/v1/compras/{id}/adjuntos" as U10
usecase "listarAdjuntos\nGET /api/v1/compras/{id}/adjuntos" as U11
usecase "descargarAdjunto\nGET /api/v1/compras/{id}/adjuntos/{adjuntoId}" as U12
usecase "eliminarAdjunto\nDELETE /api/v1/compras/{id}/adjuntos/{adjuntoId}" as U13
usecase "noComprada\nPOST /api/v1/cotizaciones/{id}/no-comprada" as U14
usecase "obtenerPorCompra\nGET /api/v1/cuentas-por-pagar/compra/{compraId}" as U15
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
ADMIN -- U8
MULTIFUNCIONAL -- U8
ADMIN -- U9
MULTIFUNCIONAL -- U9
ADMIN -- U10
MULTIFUNCIONAL -- U10
ADMIN -- U11
MULTIFUNCIONAL -- U11
ADMIN -- U12
MULTIFUNCIONAL -- U12
ADMIN -- U13
MULTIFUNCIONAL -- U13
ADMIN -- U14
MULTIFUNCIONAL -- U14
ADMIN -- U15
MULTIFUNCIONAL -- U15
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

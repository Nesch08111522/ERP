@startuml
title Casos de uso proveedores
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "proveedores" {
usecase "create\nPOST /api/v1/proveedores" as U0
usecase "update\nPUT /api/v1/proveedores/{id}" as U1
usecase "findById\nGET /api/v1/proveedores/{id}" as U2
usecase "findByDocumento\nGET /api/v1/proveedores/documento" as U3
usecase "delete\nDELETE /api/v1/proveedores/{id}" as U4
usecase "search\nGET /api/v1/proveedores" as U5
usecase "findIncompleteContactData\nGET /api/v1/proveedores/incompletos" as U6
usecase "dashboard\nGET /api/v1/proveedores/estadisticas/dashboard" as U7
usecase "statisticsByDocumentType\nGET /api/v1/proveedores/estadisticas/tipo-documento" as U8
usecase "validateDocument\nGET /api/v1/proveedores/validar/documento" as U9
usecase "rankingProveedores\nGET /api/v1/reportes/proveedores/ranking" as U10
usecase "exportarProveedores\nGET /api/v1/reportes/proveedores/ranking/exportar" as U11
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
ADMIN -- U8
MULTIFUNCIONAL -- U8
ADMIN -- U9
MULTIFUNCIONAL -- U9
ADMIN -- U10
MULTIFUNCIONAL -- U10
ADMIN -- U11
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

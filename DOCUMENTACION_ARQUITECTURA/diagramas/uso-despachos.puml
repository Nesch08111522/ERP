@startuml
title Casos de uso despachos
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "despachos" {
usecase "crear\nPOST /api/v1/despachos" as U0
usecase "dashboard\nGET /api/v1/despachos/dashboard" as U1
usecase "seguimiento\nGET /api/v1/despachos/seguimiento/{codigo}" as U2
usecase "porRepartidor\nGET /api/v1/despachos/repartidor/{userId}" as U3
usecase "buscar\nGET /api/v1/despachos" as U4
usecase "obtener\nGET /api/v1/despachos/{id}" as U5
usecase "asignarRepartidor\nPOST /api/v1/despachos/{id}/asignar-repartidor" as U6
usecase "cambiarEstado\nPATCH /api/v1/despachos/{id}/estado" as U7
usecase "registrarEntrega\nPOST /api/v1/despachos/{id}/evidencia" as U8
usecase "descargarEvidencia\nGET /api/v1/despachos/{id}/evidencia" as U9
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
ADMIN -- U7
MULTIFUNCIONAL -- U7
ADMIN -- U8
MULTIFUNCIONAL -- U8
ADMIN -- U9
MULTIFUNCIONAL -- U9
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

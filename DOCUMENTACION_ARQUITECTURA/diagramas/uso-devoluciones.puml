@startuml
title Casos de uso devoluciones
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "devoluciones" {
usecase "crear\nPOST /api/v1/devoluciones" as U0
usecase "dashboard\nGET /api/v1/devoluciones/dashboard" as U1
usecase "porVenta\nGET /api/v1/devoluciones/venta/{ventaId}" as U2
usecase "buscar\nGET /api/v1/devoluciones" as U3
usecase "obtener\nGET /api/v1/devoluciones/{id}" as U4
usecase "aprobar\nPOST /api/v1/devoluciones/{id}/aprobar" as U5
usecase "rechazar\nPOST /api/v1/devoluciones/{id}/rechazar" as U6
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
ADMIN -- U6
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml

@startuml
title Casos de uso cuentas-por-pagar
left to right direction
actor ADMIN
actor MULTIFUNCIONAL
rectangle "cuentas-por-pagar" {
usecase "buscar\nGET /api/v1/cuentas-por-pagar" as U0
usecase "obtener\nGET /api/v1/cuentas-por-pagar/{id}" as U1
usecase "registrarPago\nPOST /api/v1/cuentas-por-pagar/{id}/pago" as U2
usecase "obtenerPorCompra\nGET /api/v1/cuentas-por-pagar/compra/{compraId}" as U3
usecase "vencidas\nGET /api/v1/cuentas-por-pagar/vencidas" as U4
usecase "proximasAVencer\nGET /api/v1/cuentas-por-pagar/proximas-vencer" as U5
usecase "dashboard\nGET /api/v1/cuentas-por-pagar/dashboard" as U6
}
ADMIN -- U0
MULTIFUNCIONAL -- U0
ADMIN -- U1
MULTIFUNCIONAL -- U1
ADMIN -- U2
MULTIFUNCIONAL -- U2
ADMIN -- U3
MULTIFUNCIONAL -- U3
ADMIN -- U4
MULTIFUNCIONAL -- U4
ADMIN -- U5
MULTIFUNCIONAL -- U5
ADMIN -- U6
MULTIFUNCIONAL -- U6
note "Autorizacion condicionada por permiso, sede y propietario.\nSin include/extend: no demostrados semantica UML." as N

@enduml
